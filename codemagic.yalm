workflows:
  apk:
    name: Build APK
    max_build_duration: 30
    scripts:
      - name: Criar projeto e compilar
        script: |
          #!/usr/bin/env bash
          set -e
          mkdir -p app/src/main/java/com/example/topblocker app/src/main/res/values app/src/main/res/xml app/src/main/res/drawable app/src/main/res/mipmap-anydpi-v26
          cat > settings.gradle.kts << 'EOF_0'
          pluginManagement {
              repositories { google(); mavenCentral(); gradlePluginPortal() }
          }
          dependencyResolutionManagement {
              repositories { google(); mavenCentral() }
          }
          rootProject.name = "TopBlocker"
          include(":app")
          EOF_0
          cat > build.gradle.kts << 'EOF_1'
          plugins {
              id("com.android.application") version "8.5.2" apply false
              id("org.jetbrains.kotlin.android") version "1.9.24" apply false
          }
          EOF_1
          cat > gradle.properties << 'EOF_2'
          org.gradle.jvmargs=-Xmx2048m
          android.useAndroidX=true
          EOF_2
          cat > app/build.gradle.kts << 'EOF_3'
          plugins {
              id("com.android.application")
              id("org.jetbrains.kotlin.android")
          }
          android {
              namespace = "com.example.topblocker"
              compileSdk = 34
              defaultConfig {
                  applicationId = "com.example.topblocker"
                  minSdk = 26
                  targetSdk = 34
                  versionCode = 3
                  versionName = "3.0"
              }
              compileOptions {
                  sourceCompatibility = JavaVersion.VERSION_17
                  targetCompatibility = JavaVersion.VERSION_17
              }
              kotlinOptions { jvmTarget = "17" }
          }
          EOF_3
          cat > app/src/main/AndroidManifest.xml << 'EOF_4'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
              <application
                  android:icon="@mipmap/ic_launcher"
                  android:label="Top Blocker"
                  android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
                  <activity android:name=".MainActivity" android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
                  <activity
                      android:name=".EditorActivity"
                      android:exported="false"
                      android:screenOrientation="portrait" />
                  <service
                      android:name=".TopBlockerService"
                      android:exported="true"
                      android:label="Top Blocker"
                      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
                      <intent-filter>
                          <action android:name="android.accessibilityservice.AccessibilityService" />
                      </intent-filter>
                      <meta-data
                          android:name="android.accessibilityservice"
                          android:resource="@xml/accessibility_service_config" />
                  </service>
              </application>
          </manifest>
          EOF_4
          cat > app/src/main/res/values/strings.xml << 'EOF_5'
          <resources>
              <string name="desc_servico">Bloqueia toques na faixa superior e em blocos escolhidos da tela</string>
          </resources>
          EOF_5
          cat > app/src/main/res/values/colors.xml << 'EOF_6'
          <resources>
              <color name="ic_launcher_background">#1B1F2B</color>
          </resources>
          EOF_6
          cat > app/src/main/res/xml/accessibility_service_config.xml << 'EOF_7'
          <?xml version="1.0" encoding="utf-8"?>
          <accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
              android:accessibilityFeedbackType="feedbackGeneric"
              android:accessibilityEventTypes="typeWindowStateChanged"
              android:canRetrieveWindowContent="false"
              android:settingsActivity="com.example.topblocker.MainActivity"
              android:description="@string/desc_servico" />
          EOF_7
          cat > app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml << 'EOF_8'
          <?xml version="1.0" encoding="utf-8"?>
          <adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
              <background android:drawable="@color/ic_launcher_background" />
              <foreground android:drawable="@drawable/ic_launcher_foreground" />
          </adaptive-icon>
          EOF_8
          cat > app/src/main/res/drawable/ic_launcher_foreground.xml << 'EOF_9'
          <?xml version="1.0" encoding="utf-8"?>
          <vector xmlns:android="http://schemas.android.com/apk/res/android"
              android:width="108dp"
              android:height="108dp"
              android:viewportWidth="108"
              android:viewportHeight="108">
              <path
                  android:fillColor="#FFFFFF"
                  android:pathData="M43,24h22a5,5 0 0 1 5,5v50a5,5 0 0 1 -5,5h-22a5,5 0 0 1 -5,-5v-50a5,5 0 0 1 5,-5z" />
              <path
                  android:fillColor="#12141A"
                  android:pathData="M43,30h22a2,2 0 0 1 2,2v44a2,2 0 0 1 -2,2h-22a2,2 0 0 1 -2,-2v-44a2,2 0 0 1 2,-2z" />
              <path
                  android:fillColor="#FF4D5A"
                  android:pathData="M43,30h22a2,2 0 0 1 2,2v6h-26v-6a2,2 0 0 1 2,-2z" />
          </vector>
          EOF_9
          cat > app/src/main/java/com/example/topblocker/Cfg.kt << 'EOF_10'
          package com.example.topblocker

          object Cfg {
              const val ARQ = "cfg"
              const val ATIVO = "ativo"          // bloqueio ligado
              const val GUIA = "guia"            // areas em vermelho
              const val PREVIA = "previa"        // app principal aberto
              const val EDITANDO = "editando"    // editor de blocos aberto
              const val FIXO = "fixo"            // fixo no aparelho (nao gira com a tela)
              const val FAIXA_ON = "faixa_on"    // usar a faixa do topo
              const val BLOCOS = "blocos"        // lista de blocos
              const val ALTURA = "altura"        // espessura da faixa em dp
              const val ALTURA_PADRAO = 36
              const val MAX_BLOCOS = 12
          }
          EOF_10
          cat > app/src/main/java/com/example/topblocker/Blocos.kt << 'EOF_11'
          package com.example.topblocker

          import android.content.SharedPreferences

          // Retangulo guardado em fracoes (0..1) da tela com o aparelho em pe (retrato natural)
          data class Bloco(var l: Float, var t: Float, var r: Float, var b: Float)

          fun lim(v: Float, a: Float, b: Float): Float = maxOf(a, minOf(v, b))

          object Blocos {
              fun ler(p: SharedPreferences): MutableList<Bloco> {
                  val saida = mutableListOf<Bloco>()
                  val s = p.getString(Cfg.BLOCOS, "") ?: ""
                  if (s.isEmpty()) return saida
                  for (parte in s.split("|")) {
                      val n = parte.split(",")
                      if (n.size == 4) {
                          try {
                              saida.add(Bloco(n[0].toFloat(), n[1].toFloat(), n[2].toFloat(), n[3].toFloat()))
                          } catch (e: Exception) {
                          }
                      }
                  }
                  return saida
              }

              fun salvar(p: SharedPreferences, lista: List<Bloco>) {
                  val s = lista.joinToString("|") {
                      it.l.toString() + "," + it.t.toString() + "," + it.r.toString() + "," + it.b.toString()
                  }
                  p.edit().putString(Cfg.BLOCOS, s).apply()
              }
          }
          EOF_11
          cat > app/src/main/java/com/example/topblocker/TopBlockerService.kt << 'EOF_12'
          package com.example.topblocker

          import android.accessibilityservice.AccessibilityService
          import android.content.Intent
          import android.content.SharedPreferences
          import android.content.res.Configuration
          import android.graphics.Color
          import android.graphics.PixelFormat
          import android.graphics.Point
          import android.graphics.Rect
          import android.graphics.Typeface
          import android.graphics.drawable.GradientDrawable
          import android.hardware.display.DisplayManager
          import android.os.Build
          import android.view.Display
          import android.view.Gravity
          import android.view.Surface
          import android.view.View
          import android.view.WindowManager
          import android.view.accessibility.AccessibilityEvent
          import android.widget.TextView
          import android.widget.Toast

          class TopBlockerService : AccessibilityService(), SharedPreferences.OnSharedPreferenceChangeListener {

              private var wm: WindowManager? = null
              private var prefs: SharedPreferences? = null
              private val janelas = ArrayList<View>()
              private var chip: View? = null
              private var ultimaChave = ""

              private val ouvinteTela = object : DisplayManager.DisplayListener {
                  override fun onDisplayAdded(displayId: Int) {}
                  override fun onDisplayRemoved(displayId: Int) {}
                  override fun onDisplayChanged(displayId: Int) {
                      sincroniza()
                  }
              }

              // ---------- geometria ----------

              // Faixa do topo: fica sobre a borda fisica de cima do aparelho
              private fun retFaixa(rot: Int, w: Int, h: Int, t: Int): Rect {
                  val e = maxOf(1, minOf(t, minOf(w, h)))
                  return when (rot) {
                      Surface.ROTATION_90 -> Rect(0, 0, e, h)
                      Surface.ROTATION_180 -> Rect(0, h - e, w, h)
                      Surface.ROTATION_270 -> Rect(w - e, 0, w, h)
                      else -> Rect(0, 0, w, e)
                  }
              }

              // Bloco: guardado em fracoes do aparelho em pe; converte para a rotacao atual
              private fun retBloco(b: Bloco, rot: Int, w: Int, h: Int): Rect {
                  val f = when (rot) {
                      Surface.ROTATION_90 -> floatArrayOf(b.t, 1f - b.r, b.b, 1f - b.l)
                      Surface.ROTATION_180 -> floatArrayOf(1f - b.r, 1f - b.b, 1f - b.l, 1f - b.t)
                      Surface.ROTATION_270 -> floatArrayOf(1f - b.b, b.l, 1f - b.t, b.r)
                      else -> floatArrayOf(b.l, b.t, b.r, b.b)
                  }
                  val l = (f[0] * w).toInt()
                  val t = (f[1] * h).toInt()
                  val r = maxOf((f[2] * w).toInt(), l + 1)
                  val bt = maxOf((f[3] * h).toInt(), t + 1)
                  return Rect(l, t, r, bt)
              }

              private fun montaParams(r: Rect, bloqueando: Boolean): WindowManager.LayoutParams {
                  var flags = WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                      WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                      WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
                  // Na previa (sem bloquear) o toque atravessa
                  if (!bloqueando) flags = flags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
                  val p = WindowManager.LayoutParams(
                      r.width(),
                      r.height(),
                      WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                      flags,
                      PixelFormat.TRANSLUCENT
                  )
                  p.gravity = Gravity.TOP or Gravity.LEFT
                  p.x = r.left
                  p.y = r.top
                  if (Build.VERSION.SDK_INT >= 30) {
                      p.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
                  } else if (Build.VERSION.SDK_INT >= 28) {
                      p.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
                  }
                  return p
              }

              // ---------- janelas ----------

              private fun removeChip() {
                  val c = chip
                  if (c != null) {
                      try {
                          wm?.removeView(c)
                      } catch (e: Exception) {
                      }
                  }
                  chip = null
              }

              private fun limpa() {
                  for (v in janelas) {
                      try {
                          wm?.removeView(v)
                      } catch (e: Exception) {
                      }
                  }
                  janelas.clear()
                  removeChip()
                  ultimaChave = ""
              }

              // Botao flutuante "Parar bloqueio": fica por cima de tudo enquanto o app esta aberto,
              // para nunca ficar trancado por um bloco em cima do botao
              private fun adicionaChip() {
                  val dens = resources.displayMetrics.density
                  val tv = TextView(this)
                  tv.text = "Parar bloqueio"
                  tv.setTextColor(Color.WHITE)
                  tv.textSize = 15f
                  tv.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
                  val g = GradientDrawable()
                  g.cornerRadius = 28f * dens
                  g.setColor(Color.argb(235, 255, 77, 90))
                  tv.background = g
                  tv.setPadding((22 * dens).toInt(), (13 * dens).toInt(), (22 * dens).toInt(), (13 * dens).toInt())
                  tv.setOnClickListener {
                      prefs?.edit()?.putBoolean(Cfg.ATIVO, false)?.apply()
                  }
                  val p = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.WRAP_CONTENT,
                      WindowManager.LayoutParams.WRAP_CONTENT,
                      WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                      PixelFormat.TRANSLUCENT
                  )
                  p.gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL
                  p.y = (88 * dens).toInt()
                  wm?.addView(tv, p)
                  chip = tv
              }

              private fun sincroniza() {
                  val p = prefs ?: return
                  val editando = p.getBoolean(Cfg.EDITANDO, false)
                  val ativo = p.getBoolean(Cfg.ATIVO, false)
                  val guia = p.getBoolean(Cfg.GUIA, true)
                  val previa = p.getBoolean(Cfg.PREVIA, false)
                  val mostrar = !editando && (ativo || (previa && guia))
                  if (!mostrar) {
                      limpa()
                      return
                  }
                  val fixo = p.getBoolean(Cfg.FIXO, true)
                  val dm = getSystemService(DISPLAY_SERVICE) as DisplayManager
                  val tela: Display? = dm.getDisplay(Display.DEFAULT_DISPLAY)
                  val pt = Point()
                  tela?.getRealSize(pt)
                  if (pt.x <= 0 || pt.y <= 0) return
                  val rot = if (fixo && tela != null) tela.rotation else Surface.ROTATION_0
                  val dens = resources.displayMetrics.density
                  val espessura = (p.getInt(Cfg.ALTURA, Cfg.ALTURA_PADRAO) * dens).toInt()

                  val rects = ArrayList<Rect>()
                  if (p.getBoolean(Cfg.FAIXA_ON, true)) {
                      rects.add(retFaixa(rot, pt.x, pt.y, espessura))
                  }
                  for (blk in Blocos.ler(p)) {
                      rects.add(retBloco(blk, rot, pt.x, pt.y))
                  }
                  val cor = if (guia) Color.argb(120, 255, 59, 71) else Color.argb(1, 0, 0, 0)
                  val mostraChip = ativo && previa
                  val chave = rects.joinToString(";") { it.flattenToString() } + "|" + cor + "|" + ativo + "|" + mostraChip
                  if (chave == ultimaChave) return
                  ultimaChave = chave

                  try {
                      while (janelas.size > rects.size) {
                          val v = janelas.removeAt(janelas.size - 1)
                          try {
                              wm?.removeView(v)
                          } catch (e: Exception) {
                          }
                      }
                      for (i in rects.indices) {
                          val params = montaParams(rects[i], ativo)
                          if (i < janelas.size) {
                              val v = janelas[i]
                              v.setBackgroundColor(cor)
                              wm?.updateViewLayout(v, params)
                          } else {
                              val v = View(this)
                              v.setBackgroundColor(cor)
                              v.setOnTouchListener { _, _ -> true }
                              wm?.addView(v, params)
                              janelas.add(v)
                          }
                      }
                      removeChip()
                      if (mostraChip) adicionaChip()
                  } catch (e: Exception) {
                      ultimaChave = ""
                      Toast.makeText(this, "Top Blocker: erro ao criar as areas (" + e.message + ")", Toast.LENGTH_LONG).show()
                  }
              }

              // ---------- ciclo de vida ----------

              override fun onServiceConnected() {
                  super.onServiceConnected()
                  val p = getSharedPreferences(Cfg.ARQ, MODE_PRIVATE)
                  prefs = p
                  wm = getSystemService(WINDOW_SERVICE) as WindowManager
                  p.edit().putBoolean(Cfg.PREVIA, false).putBoolean(Cfg.EDITANDO, false).apply()
                  p.registerOnSharedPreferenceChangeListener(this)
                  val dm = getSystemService(DISPLAY_SERVICE) as DisplayManager
                  dm.registerDisplayListener(ouvinteTela, null)
                  sincroniza()
              }

              override fun onSharedPreferenceChanged(sp: SharedPreferences?, key: String?) {
                  sincroniza()
              }

              override fun onConfigurationChanged(newConfig: Configuration) {
                  super.onConfigurationChanged(newConfig)
                  sincroniza()
              }

              override fun onAccessibilityEvent(event: AccessibilityEvent?) {}

              override fun onInterrupt() {}

              private fun desliga() {
                  try {
                      val dm = getSystemService(DISPLAY_SERVICE) as DisplayManager
                      dm.unregisterDisplayListener(ouvinteTela)
                  } catch (e: Exception) {
                  }
                  limpa()
              }

              override fun onUnbind(intent: Intent?): Boolean {
                  desliga()
                  return super.onUnbind(intent)
              }

              override fun onDestroy() {
                  prefs?.unregisterOnSharedPreferenceChangeListener(this)
                  desliga()
                  super.onDestroy()
              }
          }
          EOF_12
          cat > app/src/main/java/com/example/topblocker/AreaView.kt << 'EOF_13'
          package com.example.topblocker

          import android.content.Context
          import android.graphics.Canvas
          import android.graphics.Color
          import android.graphics.Paint
          import android.graphics.Point
          import android.graphics.RectF
          import android.graphics.Typeface
          import android.hardware.display.DisplayManager
          import android.view.Display
          import android.view.MotionEvent
          import android.view.View
          import kotlin.math.hypot

          // Tela do editor: mostra o aparelho em pe e deixa mover/redimensionar os blocos
          class AreaView(ctx: Context) : View(ctx) {

              var blocos: MutableList<Bloco> = mutableListOf()
              var selecionado = -1
              var faixaPx = 0f
              var faixaOn = true
              var aoMudar: (() -> Unit)? = null
              var aoSelecionar: ((Int) -> Unit)? = null

              private val d = ctx.resources.displayMetrics.density
              private val loc = IntArray(2)
              private var telaW = 1f
              private var telaH = 1f
              private var modo = 0
              private var canto = 0
              private var dx = 0f
              private var dy = 0f
              private val pFill = Paint(Paint.ANTI_ALIAS_FLAG)
              private val pLinha = Paint(Paint.ANTI_ALIAS_FLAG)
              private val pTexto = Paint(Paint.ANTI_ALIAS_FLAG)

              init {
                  setBackgroundColor(Color.parseColor("#0E1014"))
                  pLinha.style = Paint.Style.STROKE
                  pTexto.textAlign = Paint.Align.CENTER
                  pTexto.typeface = Typeface.DEFAULT_BOLD
              }

              private fun medeTela() {
                  val dm = context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager
                  val pt = Point()
                  dm.getDisplay(Display.DEFAULT_DISPLAY).getRealSize(pt)
                  if (pt.x > 0 && pt.y > 0) {
                      telaW = pt.x.toFloat()
                      telaH = pt.y.toFloat()
                  }
              }

              override fun onAttachedToWindow() {
                  super.onAttachedToWindow()
                  medeTela()
              }

              override fun onSizeChanged(w: Int, h: Int, ow: Int, oh: Int) {
                  super.onSizeChanged(w, h, ow, oh)
                  medeTela()
              }

              // Novo bloco quadrado, perto do centro
              fun criaBloco(n: Int): Bloco {
                  val lado = 0.30f * telaW
                  val fw = lado / telaW
                  val fh = lado / telaH
                  val desl = (n % 5) * 0.03f
                  val l = lim(0.35f + desl, 0f, 1f - fw)
                  val t = lim(0.5f - fh / 2f + desl, 0f, 1f - fh)
                  return Bloco(l, t, l + fw, t + fh)
              }

              override fun onDraw(c: Canvas) {
                  super.onDraw(c)
                  getLocationOnScreen(loc)
                  val ox = loc[0].toFloat()
                  val oy = loc[1].toFloat()

                  // moldura do aparelho
                  pLinha.color = Color.parseColor("#2B303B")
                  pLinha.strokeWidth = 2f * d
                  c.drawRect(d - ox, d - oy, telaW - d - ox, telaH - d - oy, pLinha)

                  // faixa do topo (so referencia)
                  if (faixaOn) {
                      pFill.color = Color.argb(70, 255, 77, 90)
                      c.drawRect(0f - ox, 0f - oy, telaW - ox, faixaPx - oy, pFill)
                      pTexto.color = Color.argb(210, 255, 255, 255)
                      pTexto.textSize = 11f * d
                      c.drawText("faixa do topo", telaW / 2f - ox, faixaPx / 2f + 4f * d - oy, pTexto)
                  }

                  if (blocos.isEmpty()) {
                      pTexto.color = Color.parseColor("#9AA3B2")
                      pTexto.textSize = 15f * d
                      c.drawText("Toque em + Novo para criar um bloco", telaW / 2f - ox, telaH / 2f - oy, pTexto)
                  }

                  for (i in blocos.indices) {
                      val b = blocos[i]
                      val r = RectF(b.l * telaW - ox, b.t * telaH - oy, b.r * telaW - ox, b.b * telaH - oy)
                      pFill.color = Color.argb(120, 255, 59, 71)
                      c.drawRoundRect(r, 8f * d, 8f * d, pFill)
                      if (i == selecionado) {
                          pLinha.color = Color.parseColor("#6C7BFF")
                          pLinha.strokeWidth = 3f * d
                      } else {
                          pLinha.color = Color.WHITE
                          pLinha.strokeWidth = 1.5f * d
                      }
                      c.drawRoundRect(r, 8f * d, 8f * d, pLinha)
                      pTexto.color = Color.WHITE
                      pTexto.textSize = 18f * d
                      c.drawText((i + 1).toString(), r.centerX(), r.centerY() + 6f * d, pTexto)

                      if (i == selecionado) {
                          val xs = floatArrayOf(r.left, r.right, r.right, r.left)
                          val ys = floatArrayOf(r.top, r.top, r.bottom, r.bottom)
                          for (k in 0 until 4) {
                              pFill.color = Color.WHITE
                              c.drawCircle(xs[k], ys[k], 10f * d, pFill)
                              pLinha.color = Color.parseColor("#6C7BFF")
                              pLinha.strokeWidth = 3f * d
                              c.drawCircle(xs[k], ys[k], 10f * d, pLinha)
                          }
                      }
                  }
              }

              override fun onTouchEvent(e: MotionEvent): Boolean {
                  val fx = e.rawX / telaW
                  val fy = e.rawY / telaH
                  when (e.actionMasked) {
                      MotionEvent.ACTION_DOWN -> {
                          modo = 0
                          if (selecionado in blocos.indices) {
                              val b = blocos[selecionado]
                              val xs = floatArrayOf(b.l, b.r, b.r, b.l)
                              val ys = floatArrayOf(b.t, b.t, b.b, b.b)
                              for (k in 0 until 4) {
                                  val dist = hypot(e.rawX - xs[k] * telaW, e.rawY - ys[k] * telaH)
                                  if (dist < 30f * d) {
                                      modo = 2
                                      canto = k
                                      return true
                                  }
                              }
                          }
                          for (i in blocos.indices.reversed()) {
                              val b = blocos[i]
                              if (fx >= b.l && fx <= b.r && fy >= b.t && fy <= b.b) {
                                  selecionado = i
                                  modo = 1
                                  dx = fx - b.l
                                  dy = fy - b.t
                                  aoSelecionar?.invoke(i)
                                  invalidate()
                                  return true
                              }
                          }
                          selecionado = -1
                          aoSelecionar?.invoke(-1)
                          invalidate()
                          return true
                      }
                      MotionEvent.ACTION_MOVE -> {
                          if (selecionado in blocos.indices) {
                              val b = blocos[selecionado]
                              if (modo == 1) {
                                  val larg = b.r - b.l
                                  val alt = b.b - b.t
                                  b.l = lim(fx - dx, 0f, 1f - larg)
                                  b.t = lim(fy - dy, 0f, 1f - alt)
                                  b.r = b.l + larg
                                  b.b = b.t + alt
                                  invalidate()
                              } else if (modo == 2) {
                                  val minW = 40f * d / telaW
                                  val minH = 40f * d / telaH
                                  when (canto) {
                                      0 -> {
                                          b.l = lim(fx, 0f, b.r - minW)
                                          b.t = lim(fy, 0f, b.b - minH)
                                      }
                                      1 -> {
                                          b.r = lim(fx, b.l + minW, 1f)
                                          b.t = lim(fy, 0f, b.b - minH)
                                      }
                                      2 -> {
                                          b.r = lim(fx, b.l + minW, 1f)
                                          b.b = lim(fy, b.t + minH, 1f)
                                      }
                                      else -> {
                                          b.l = lim(fx, 0f, b.r - minW)
                                          b.b = lim(fy, b.t + minH, 1f)
                                      }
                                  }
                                  invalidate()
                              }
                          }
                          return true
                      }
                      MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                          if (modo != 0) aoMudar?.invoke()
                          modo = 0
                          return true
                      }
                  }
                  return true
              }
          }
