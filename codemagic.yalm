          cat > app/src/main/java/com/example/topblocker/EditorActivity.kt << 'EOF_14'
          package com.example.topblocker

          import android.app.Activity
          import android.content.SharedPreferences
          import android.content.res.ColorStateList
          import android.graphics.Color
          import android.graphics.Typeface
          import android.graphics.drawable.GradientDrawable
          import android.graphics.drawable.RippleDrawable
          import android.os.Build
          import android.os.Bundle
          import android.view.Gravity
          import android.view.View
          import android.view.ViewGroup
          import android.view.WindowManager
          import android.widget.Button
          import android.widget.FrameLayout
          import android.widget.LinearLayout
          import android.widget.TextView
          import android.widget.Toast

          class EditorActivity : Activity() {

              private val acento = Color.parseColor("#6C7BFF")
              private val vermelho = Color.parseColor("#FF4D5A")
              private val neutro = Color.parseColor("#2A3040")

              private lateinit var prefs: SharedPreferences
              private lateinit var area: AreaView
              private lateinit var barra: LinearLayout
              private lateinit var dica: TextView
              private var blocos: MutableList<Bloco> = mutableListOf()
              private var barraEmbaixo = true

              private fun dp(v: Int): Int = (v * resources.displayMetrics.density + 0.5f).toInt()

              private fun forma(cor: Int, raio: Int): GradientDrawable {
                  val g = GradientDrawable()
                  g.shape = GradientDrawable.RECTANGLE
                  g.cornerRadius = dp(raio).toFloat()
                  g.setColor(cor)
                  return g
              }

              private fun ripple(cor: Int, raio: Int): RippleDrawable {
                  return RippleDrawable(
                      ColorStateList.valueOf(Color.argb(60, 255, 255, 255)),
                      forma(cor, raio),
                      forma(Color.WHITE, raio)
                  )
              }

              private fun botao(t: String, cor: Int, aoClicar: () -> Unit): Button {
                  val b = Button(this)
                  b.text = t
                  b.isAllCaps = false
                  b.textSize = 13f
                  b.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
                  b.setTextColor(Color.WHITE)
                  b.background = ripple(cor, 14)
                  b.stateListAnimator = null
                  b.minWidth = 0
                  b.minimumWidth = 0
                  b.minimumHeight = dp(44)
                  b.setPadding(dp(6), dp(8), dp(6), dp(8))
                  b.setOnClickListener { aoClicar() }
                  return b
              }

              private fun peso(): LinearLayout.LayoutParams {
                  val lp = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
                  lp.setMargins(dp(3), 0, dp(3), 0)
                  return lp
              }

              private fun modoTelaCheia() {
                  window.decorView.systemUiVisibility = View.SYSTEM_UI_FLAG_LAYOUT_STABLE or
                      View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION or
                      View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN or
                      View.SYSTEM_UI_FLAG_HIDE_NAVIGATION or
                      View.SYSTEM_UI_FLAG_FULLSCREEN or
                      View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
              }

              private fun aviso(t: String) {
                  Toast.makeText(this, t, Toast.LENGTH_SHORT).show()
              }

              private fun atualizaDica() {
                  val i = area.selecionado
                  if (i in blocos.indices) {
                      dica.text = "Bloco " + (i + 1) + " selecionado. Arraste para mover; arraste os cantos para mudar o tamanho."
                  } else if (blocos.isEmpty()) {
                      dica.text = "Toque em + Novo para criar um bloco. Ele bloqueia os toques dentro dele."
                  } else {
                      dica.text = "Toque em um bloco para selecioná-lo."
                  }
              }

              private fun novo() {
                  if (blocos.size >= Cfg.MAX_BLOCOS) {
                      aviso("Máximo de " + Cfg.MAX_BLOCOS + " blocos")
                      return
                  }
                  blocos.add(area.criaBloco(blocos.size))
                  area.selecionado = blocos.size - 1
                  Blocos.salvar(prefs, blocos)
                  area.invalidate()
                  atualizaDica()
              }

              private fun excluir() {
                  val i = area.selecionado
                  if (i in blocos.indices) {
                      blocos.removeAt(i)
                      area.selecionado = -1
                      Blocos.salvar(prefs, blocos)
                      area.invalidate()
                      atualizaDica()
                  } else {
                      aviso("Toque em um bloco para selecioná-lo")
                  }
              }

              private fun moverBarra() {
                  barraEmbaixo = !barraEmbaixo
                  val lp = barra.layoutParams as FrameLayout.LayoutParams
                  if (barraEmbaixo) {
                      lp.gravity = Gravity.BOTTOM
                      lp.setMargins(dp(12), dp(12), dp(12), dp(28))
                  } else {
                      lp.gravity = Gravity.TOP
                      lp.setMargins(dp(12), dp(40), dp(12), dp(12))
                  }
                  barra.layoutParams = lp
              }

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  prefs = getSharedPreferences(Cfg.ARQ, MODE_PRIVATE)

                  window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS)
                  val wlp = window.attributes
                  if (Build.VERSION.SDK_INT >= 30) {
                      wlp.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
                  } else if (Build.VERSION.SDK_INT >= 28) {
                      wlp.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
                  }
                  window.attributes = wlp
                  window.statusBarColor = Color.TRANSPARENT
                  window.navigationBarColor = Color.TRANSPARENT
                  modoTelaCheia()

                  blocos = Blocos.ler(prefs)

                  area = AreaView(this)
                  area.blocos = blocos
                  area.faixaOn = prefs.getBoolean(Cfg.FAIXA_ON, true)
                  area.faixaPx = prefs.getInt(Cfg.ALTURA, Cfg.ALTURA_PADRAO) * resources.displayMetrics.density
                  area.aoMudar = { Blocos.salvar(prefs, blocos) }
                  area.aoSelecionar = { atualizaDica() }

                  barra = LinearLayout(this)
                  barra.orientation = LinearLayout.VERTICAL
                  barra.isClickable = true
                  barra.background = forma(Color.parseColor("#F2181B22"), 20)
                  barra.setPadding(dp(14), dp(12), dp(14), dp(12))

                  dica = TextView(this)
                  dica.textSize = 13f
                  dica.setTextColor(Color.parseColor("#C5CBD6"))
                  dica.setPadding(0, 0, 0, dp(10))
                  barra.addView(dica)

                  val fila = LinearLayout(this)
                  fila.orientation = LinearLayout.HORIZONTAL
                  fila.addView(botao("+ Novo", acento) { novo() }, peso())
                  fila.addView(botao("Excluir", vermelho) { excluir() }, peso())
                  fila.addView(botao("Barra ↑↓", neutro) { moverBarra() }, peso())
                  fila.addView(botao("Pronto", neutro) { finish() }, peso())
                  barra.addView(fila)

                  val raiz = FrameLayout(this)
                  raiz.addView(area, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
                  val lp = FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
                  lp.gravity = Gravity.BOTTOM
                  lp.setMargins(dp(12), dp(12), dp(12), dp(28))
                  raiz.addView(barra, lp)
                  setContentView(raiz)
                  atualizaDica()
              }

              override fun onWindowFocusChanged(hasFocus: Boolean) {
                  super.onWindowFocusChanged(hasFocus)
                  if (hasFocus) modoTelaCheia()
              }

              override fun onResume() {
                  super.onResume()
                  prefs.edit().putBoolean(Cfg.EDITANDO, true).apply()
              }

              override fun onPause() {
                  Blocos.salvar(prefs, blocos)
                  prefs.edit().putBoolean(Cfg.EDITANDO, false).apply()
                  super.onPause()
              }
          }
          EOF_14
          cat > app/src/main/java/com/example/topblocker/MainActivity.kt << 'EOF_15'
          package com.example.topblocker

          import android.app.Activity
          import android.content.ComponentName
          import android.content.Intent
          import android.content.SharedPreferences
          import android.content.res.ColorStateList
          import android.graphics.Color
          import android.graphics.Typeface
          import android.graphics.drawable.GradientDrawable
          import android.graphics.drawable.RippleDrawable
          import android.net.Uri
          import android.os.Bundle
          import android.provider.Settings
          import android.view.Gravity
          import android.view.View
          import android.view.ViewGroup
          import android.widget.Button
          import android.widget.LinearLayout
          import android.widget.ScrollView
          import android.widget.SeekBar
          import android.widget.Switch
          import android.widget.TextView
          import android.widget.Toast

          class MainActivity : Activity() {

              private val fundo = Color.parseColor("#0E1014")
              private val cartao = Color.parseColor("#181B22")
              private val borda = Color.parseColor("#2B303B")
              private val texto1 = Color.parseColor("#F2F4F8")
              private val texto2 = Color.parseColor("#9AA3B2")
              private val acento = Color.parseColor("#6C7BFF")
              private val verde = Color.parseColor("#2ECC8F")
              private val vermelho = Color.parseColor("#FF4D5A")

              private lateinit var prefs: SharedPreferences
              private lateinit var pillAcess: TextView
              private lateinit var pillOverlay: TextView
              private lateinit var principal: Button
              private lateinit var statusTxt: TextView
              private lateinit var valorTxt: TextView
              private lateinit var blocosTxt: TextView

              // ---------- helpers de visual ----------

              private fun dp(v: Int): Int = (v * resources.displayMetrics.density + 0.5f).toInt()

              private fun forma(cor: Int, raio: Int, contorno: Int? = null): GradientDrawable {
                  val g = GradientDrawable()
                  g.shape = GradientDrawable.RECTANGLE
                  g.cornerRadius = dp(raio).toFloat()
                  g.setColor(cor)
                  if (contorno != null) g.setStroke(dp(1), contorno)
                  return g
              }

              private fun ripple(cor: Int, raio: Int, contorno: Int? = null): RippleDrawable {
                  return RippleDrawable(
                      ColorStateList.valueOf(Color.argb(60, 255, 255, 255)),
                      forma(cor, raio, contorno),
                      forma(Color.WHITE, raio)
                  )
              }

              private fun texto(t: String, tam: Float, cor: Int, negrito: Boolean = false): TextView {
                  val tv = TextView(this)
                  tv.text = t
                  tv.textSize = tam
                  tv.setTextColor(cor)
                  if (negrito) tv.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
                  return tv
              }

              private fun secao(t: String): TextView {
                  val tv = texto(t, 12f, texto2, true)
                  tv.letterSpacing = 0.08f
                  tv.setPadding(dp(4), 0, 0, dp(8))
                  return tv
              }

              private fun dicaTxt(t: String): TextView {
                  val tv = texto(t, 12f, texto2)
                  tv.setPadding(0, dp(6), 0, 0)
                  return tv
              }

              private fun link(t: String, aoClicar: () -> Unit): TextView {
                  val tv = texto(t, 13f, acento)
                  tv.setPadding(0, dp(12), 0, dp(4))
                  tv.setOnClickListener { aoClicar() }
                  return tv
              }

              private fun card(): LinearLayout {
                  val c = LinearLayout(this)
                  c.orientation = LinearLayout.VERTICAL
                  c.background = forma(cartao, 20, borda)
                  c.setPadding(dp(18), dp(18), dp(18), dp(18))
                  return c
              }

              private fun botao(t: String, cor: Int, corTexto: Int, aoClicar: () -> Unit): Button {
                  val b = Button(this)
                  b.text = t
                  b.isAllCaps = false
                  b.textSize = 15f
                  b.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
                  b.setTextColor(corTexto)
                  b.background = ripple(cor, 16)
                  b.stateListAnimator = null
                  b.minimumHeight = dp(50)
                  b.setPadding(dp(16), dp(12), dp(16), dp(12))
                  b.setOnClickListener { aoClicar() }
                  return b
              }

              private fun botaoContorno(t: String, aoClicar: () -> Unit): Button {
                  val b = botao(t, Color.TRANSPARENT, texto1, aoClicar)
                  b.background = ripple(Color.TRANSPARENT, 16, Color.parseColor("#3C4352"))
                  b.setPadding(dp(16), dp(12), dp(16), dp(12))
                  return b
              }

              private fun botaoRedondo(t: String, aoClicar: () -> Unit): Button {
                  val b = Button(this)
                  b.text = t
                  b.textSize = 20f
                  b.setTextColor(texto1)
                  b.background = ripple(Color.parseColor("#232834"), 24)
                  b.stateListAnimator = null
                  b.minWidth = 0
                  b.minimumWidth = 0
                  b.minHeight = 0
                  b.minimumHeight = 0
                  b.setPadding(0, 0, 0, 0)
                  b.setOnClickListener { aoClicar() }
                  return b
              }

              private fun interruptor(txt: String, chave: String, padrao: Boolean): Switch {
                  val sw = Switch(this)
                  sw.text = txt
                  sw.textSize = 15f
                  sw.setTextColor(texto1)
                  sw.isChecked = prefs.getBoolean(chave, padrao)
                  val est = arrayOf(intArrayOf(android.R.attr.state_checked), intArrayOf())
                  sw.thumbTintList = ColorStateList(est, intArrayOf(acento, Color.parseColor("#8A93A3")))
                  sw.trackTintList = ColorStateList(est, intArrayOf(Color.parseColor("#3B4278"), Color.parseColor("#2C3240")))
                  sw.setOnCheckedChangeListener { _, marcado -> prefs.edit().putBoolean(chave, marcado).apply() }
                  return sw
              }

              private fun novaPill(): TextView {
                  val p = TextView(this)
                  p.textSize = 11f
                  p.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
                  return p
              }

              private fun pintaPill(tv: TextView, ok: Boolean, rotuloOk: String, rotuloNao: String, critico: Boolean) {
                  if (ok) {
                      tv.text = rotuloOk
                      tv.setTextColor(verde)
                      tv.background = forma(Color.parseColor("#12382B"), 10)
                  } else if (critico) {
                      tv.text = rotuloNao
                      tv.setTextColor(vermelho)
                      tv.background = forma(Color.parseColor("#3C1D22"), 10)
                  } else {
                      tv.text = rotuloNao
                      tv.setTextColor(texto2)
                      tv.background = forma(Color.parseColor("#262A33"), 10)
                  }
                  tv.setPadding(dp(10), dp(5), dp(10), dp(5))
              }

              private fun linha(titulo: String, desc: String, pill: TextView): LinearLayout {
                  val l = LinearLayout(this)
                  l.orientation = LinearLayout.HORIZONTAL
                  l.gravity = Gravity.CENTER_VERTICAL
                  val col = LinearLayout(this)
                  col.orientation = LinearLayout.VERTICAL
                  col.addView(texto(titulo, 16f, texto1, true))
                  val d = texto(desc, 13f, texto2)
                  d.setPadding(0, dp(2), dp(10), 0)
                  col.addView(d)
                  l.addView(col, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
                  l.addView(pill, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
                  return l
              }

              private fun divisor(): View {
                  val v = View(this)
                  v.setBackgroundColor(borda)
                  return v
              }

              private fun LinearLayout.adiciona(v: View, topo: Int = 0, altura: Int = ViewGroup.LayoutParams.WRAP_CONTENT) {
                  val lp = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, altura)
                  lp.topMargin = dp(topo)
                  addView(v, lp)
              }

              private fun abre(intent: Intent) {
                  try {
                      startActivity(intent)
                  } catch (e: Exception) {
                      Toast.makeText(this, "Não consegui abrir essa tela", Toast.LENGTH_LONG).show()
                  }
              }

              // ---------- estado ----------

              private fun servicoAtivo(): Boolean {
                  val lista = Settings.Secure.getString(contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES) ?: return false
                  val alvo = ComponentName(this, TopBlockerService::class.java)
                  return lista.split(':').any { ComponentName.unflattenFromString(it) == alvo }
              }

              private fun ligado(): Boolean = prefs.getBoolean(Cfg.ATIVO, false) && servicoAtivo()

              private fun alternar() {
                  if (ligado()) {
                      prefs.edit().putBoolean(Cfg.ATIVO, false).apply()
                  } else {
                      if (!servicoAtivo()) {
                          prefs.edit().putBoolean(Cfg.ATIVO, false).apply()
                          Toast.makeText(this, "Primeiro ative o Top Blocker na acessibilidade", Toast.LENGTH_LONG).show()
                          abre(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                          return
                      }
                      prefs.edit().putBoolean(Cfg.ATIVO, true).apply()
                  }
                  atualizaTela()
              }

              private fun atualizaTela() {
                  val acess = servicoAtivo()
                  pintaPill(pillAcess, acess, "ATIVO", "DESLIGADO", true)
                  pintaPill(pillOverlay, Settings.canDrawOverlays(this), "PERMITIDO", "NÃO PERMITIDO", false)

                  val n = Blocos.ler(prefs).size
                  blocosTxt.text = if (n == 0) "Nenhum bloco criado" else if (n == 1) "1 bloco criado" else n.toString() + " blocos criados"

                  if (ligado()) {
                      principal.text = "Parar bloqueio"
                      principal.setTextColor(Color.WHITE)
                      principal.background = ripple(vermelho, 16)
                      statusTxt.text = "Bloqueio LIGADO. Toques na faixa e nos blocos estão sendo ignorados."
                      statusTxt.setTextColor(verde)
                  } else {
                      principal.text = "Iniciar bloqueio"
                      principal.setTextColor(Color.parseColor("#06251A"))
                      principal.background = ripple(verde, 16)
                      statusTxt.text = if (acess) "Bloqueio desligado. Ajuste as áreas e toque em Iniciar." else "Ative o serviço de acessibilidade (passo 1) para poder bloquear."
                      statusTxt.setTextColor(texto2)
                  }
                  principal.setPadding(dp(16), dp(12), dp(16), dp(12))
              }

              // ---------- ciclo de vida ----------

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  prefs = getSharedPreferences(Cfg.ARQ, MODE_PRIVATE)
                  window.statusBarColor = fundo
                  window.navigationBarColor = fundo

                  val col = LinearLayout(this)
                  col.orientation = LinearLayout.VERTICAL
                  col.setPadding(dp(18), dp(24), dp(18), dp(32))

                  col.addView(texto("Top Blocker", 30f, texto1, true))
                  val sub = texto("Bloqueie toques fantasma na parte de cima da tela.", 14f, texto2)
                  sub.setPadding(0, dp(4), 0, 0)
                  col.addView(sub)

                  // 1 - Permissoes
                  col.adiciona(secao("1 · PERMISSÕES"), 22)
                  val c1 = card()
                  pillAcess = novaPill()
                  c1.adiciona(linha("Serviço de acessibilidade", "Obrigatório. É ele que bloqueia os toques.", pillAcess))
                  c1.adiciona(botao("Abrir acessibilidade", acento, Color.WHITE) {
                      abre(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                  }, 14)
                  c1.adiciona(link("Não consegue ativar? Permitir configurações restritas") {
                      abre(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:" + packageName)))
                  })
                  c1.adiciona(dicaTxt("Na tela do app, toque nos três pontinhos > Permitir configurações restritas. Depois volte, abra Apps instalados e ative o Top Blocker."))
                  c1.adiciona(divisor(), 18, dp(1))
                  pillOverlay = novaPill()
                  c1.adiciona(linha("Sobrepor outros apps", "Opcional. O bloqueio funciona só com a acessibilidade.", pillOverlay), 18)
                  c1.adiciona(botaoContorno("Abrir permissão de sobreposição") {
                      abre(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, Uri.parse("package:" + packageName)))
                  }, 14)
                  col.adiciona(c1)

                  // 2 - Faixa do topo
                  col.adiciona(secao("2 · FAIXA DO TOPO"), 22)
                  val c2 = card()
                  c2.adiciona(interruptor("Usar faixa do topo", Cfg.FAIXA_ON, true))
                  val alturaAtual = prefs.getInt(Cfg.ALTURA, Cfg.ALTURA_PADRAO).coerceIn(10, 150)
                  valorTxt = texto(alturaAtual.toString() + " dp", 34f, texto1, true)
                  valorTxt.gravity = Gravity.CENTER
                  c2.adiciona(valorTxt, 16)
                  val legenda = texto("espessura da faixa na borda de cima", 13f, texto2)
                  legenda.gravity = Gravity.CENTER
                  c2.adiciona(legenda)

                  val bar = SeekBar(this)
                  bar.min = 10
                  bar.max = 150
                  bar.progress = alturaAtual
                  bar.progressTintList = ColorStateList.valueOf(acento)
                  bar.thumbTintList = ColorStateList.valueOf(acento)
                  bar.progressBackgroundTintList = ColorStateList.valueOf(Color.parseColor("#2C3240"))
                  bar.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
                      override fun onProgressChanged(s: SeekBar?, p: Int, doUsuario: Boolean) {
                          valorTxt.text = p.toString() + " dp"
                          prefs.edit().putInt(Cfg.ALTURA, p).apply()
                      }
                      override fun onStartTrackingTouch(s: SeekBar?) {}
                      override fun onStopTrackingTouch(s: SeekBar?) {}
                  })

                  val ajuste = LinearLayout(this)
                  ajuste.orientation = LinearLayout.HORIZONTAL
                  ajuste.gravity = Gravity.CENTER_VERTICAL
                  ajuste.addView(botaoRedondo("−") { bar.progress = bar.progress - 1 }, LinearLayout.LayoutParams(dp(46), dp(46)))
                  ajuste.addView(bar, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
                  ajuste.addView(botaoRedondo("+") { bar.progress = bar.progress + 1 }, LinearLayout.LayoutParams(dp(46), dp(46)))
                  c2.adiciona(ajuste, 14)
                  c2.adiciona(dicaTxt("Na horizontal, a faixa continua sobre o topo físico do celular (vira uma barra lateral)."), 10)
                  col.adiciona(c2)

                  // 3 - Blocos
                  col.adiciona(secao("3 · BLOCOS (QUADRADOS)"), 22)
                  val c3 = card()
                  blocosTxt = texto("", 16f, texto1, true)
                  c3.adiciona(blocosTxt)
                  c3.adiciona(dicaTxt("Crie quadrados e posicione onde quiser na tela. Cada um bloqueia os toques dentro dele, além da faixa do topo."), 4)
                  c3.adiciona(botao("Abrir editor de blocos", acento, Color.WHITE) {
                      abre(Intent(this@MainActivity, EditorActivity::class.java))
                  }, 14)
                  col.adiciona(c3)

                  // 4 - Opcoes
                  col.adiciona(secao("4 · OPÇÕES"), 22)
                  val c4 = card()
                  c4.adiciona(interruptor("Mostrar áreas em vermelho", Cfg.GUIA, true))
                  c4.adiciona(dicaTxt("Mostra onde os toques serão bloqueados. Aparece enquanto este app está aberto e durante o bloqueio."), 4)
                  c4.adiciona(divisor(), 16, dp(1))
                  c4.adiciona(interruptor("Fixar no aparelho (não gira com a tela)", Cfg.FIXO, true), 16)
                  c4.adiciona(dicaTxt("Ligado: faixa e blocos ficam sempre sobre a mesma parte física do celular, mesmo na horizontal."), 4)
                  col.adiciona(c4)

                  // 5 - Bloqueio
                  col.adiciona(secao("5 · BLOQUEIO"), 22)
                  val c5 = card()
                  statusTxt = texto("", 14f, texto2)
                  c5.adiciona(statusTxt)
                  principal = botao("Iniciar bloqueio", verde, Color.parseColor("#06251A")) { alternar() }
                  principal.textSize = 17f
                  principal.minimumHeight = dp(58)
                  c5.adiciona(principal, 14)
                  c5.adiciona(dicaTxt("Com o bloqueio ligado, um botão Parar bloqueio aparece por cima de tudo enquanto este app está aberto. Fora dele, você não consegue puxar a barra de notificações pela faixa."), 12)
                  col.adiciona(c5)

                  val scroll = ScrollView(this)
                  scroll.setBackgroundColor(fundo)
                  scroll.isFillViewport = true
                  scroll.addView(col)
                  setContentView(scroll)
              }

              override fun onResume() {
                  super.onResume()
                  prefs.edit().putBoolean(Cfg.PREVIA, true).putBoolean(Cfg.EDITANDO, false).apply()
                  atualizaTela()
              }

              override fun onPause() {
                  prefs.edit().putBoolean(Cfg.PREVIA, false).apply()
                  super.onPause()
              }
          }
          EOF_15
          echo "sdk.dir=$ANDROID_SDK_ROOT" > local.properties
          java -version
          curl -sSL -o gradle.zip https://services.gradle.org/distributions/gradle-8.7-bin.zip
          unzip -q gradle.zip
          ./gradle-8.7/bin/gradle assembleDebug --no-daemon
    artifacts:
      - app/build/outputs/apk/debug/app-debug.apk
